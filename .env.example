# Postgres — added automatically when you connect Neon in Vercel → Storage.
# Leave empty locally to use the embedded database in ./.data
DATABASE_URL=

# Free AI providers (set at least one). Oryn uses Groq first and falls back to Gemini.
GROQ_API_KEY=          # https://console.groq.com/keys
GEMINI_API_KEY=        # https://aistudio.google.com/apikey
# Optional model overrides
# GROQ_MODEL=llama-3.3-70b-versatile
# GEMINI_MODEL=gemini-2.5-flash

# Protects the daily weekly-brief cron (any long random string)
CRON_SECRET=

# Public URL used for metadata/sitemap
NEXT_PUBLIC_SITE_URL=
